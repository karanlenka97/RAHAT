# =========================================================================
# RAHAT (Rural Healthcare Access & Referral Assistance Technology)
# Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Update passwords, JWT_SECRET, and API keys for your target environment.
# 3. NEVER commit the actual .env file with secrets into version control.
# =========================================================================

# -------------------------------------------------------------------------
# 1. Environment & Debug Modes
# -------------------------------------------------------------------------
# Options: "development", "staging", "production"
ENVIRONMENT=development
# In production, DEBUG must be set to False
DEBUG=True

# -------------------------------------------------------------------------
# 2. Security & JWT Authentication
# -------------------------------------------------------------------------
# CRITICAL: In production, generate a strong random secret with: openssl rand -hex 32
JWT_SECRET=rahat-dev-insecure-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------------------------------------
# 3. Backend Service & Server Configuration
# -------------------------------------------------------------------------
BACKEND_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="RAHAT - Rural Assistance & Healthcare Access Tele-network"
# JSON array or comma-separated string of allowed CORS origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Production ASGI Uvicorn worker count
UVICORN_WORKERS=2
# Set to true to automatically seed reference and demo data on container start
RUN_DB_SEED=false

# -------------------------------------------------------------------------
# 4. Frontend Application
# -------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="RAHAT"

# -------------------------------------------------------------------------
# 5. PostgreSQL + PostGIS Spatial Database
# -------------------------------------------------------------------------
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rahat_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rahat_db

# -------------------------------------------------------------------------
# 6. Redis In-Memory Cache & Broker
# -------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------------------------------------
# 7. AI Referral Assistant Configuration
# -------------------------------------------------------------------------
# Provider options: "mock" (synthetic deterministic), "gemini", "openai"
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash
# Required if AI_PROVIDER=gemini (keep server-side only; never expose to frontend)
AI_API_KEY=
AI_TIMEOUT_SECONDS=15
AI_RATE_LIMIT_PER_MINUTE=30
