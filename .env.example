# ==========================================
# RAHAT / SwasthyaSetu - Environment Configuration
# ==========================================

# General Environment
ENVIRONMENT=development
DEBUG=True

# Security & JWT Authentication
JWT_SECRET=replace-with-a-secure-random-secret-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend Service
BACKEND_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="RAHAT - Rural Assistance & Healthcare Access Tele-network"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Application
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL + PostGIS Spatial Database
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rahat_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rahat_db

# Redis Cache & Broker
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
