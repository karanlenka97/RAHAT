# Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=True

# Security & JWT Authentication
JWT_SECRET=replace-with-a-secure-random-secret-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Configuration
PROJECT_NAME="RAHAT - Rural Assistance & Healthcare Access Tele-network"
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL + PostGIS Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rahat_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rahat_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
